+"""rumblex end to end: Rumble-2-Flash decodes, its own CTC head times the words (`rumblex.transcribe`).
+Track 2, no transcript given. The track 1 row `rumblex` is the same package given the reference words."""
+from __future__ import annotations
+
+from fabench.timestamp_asrs.subprocess_asr import SubprocessTimestampASR
+
+
+class RumblexASR(SubprocessTimestampASR):
+    default_model = "Reson8/Rumble-2-Flash"
+    frame_s = 1 / 13
+
+    def _extra_argv(self) -> list[str]:
+        return [str(self.params.get("device", "cuda")), "transcribe"]
