+"""rumblex forced alignment: the Rumble-2-Flash encoder and its CTC head place the words of a given
+transcript (`rumblex.align`). Word tier only. Runs in its own interpreter."""
+from __future__ import annotations
+
+from fabench.aligners.subprocess_aligner import SubprocessAligner
+
+
+class Rumblex(SubprocessAligner):
+    name = "rumblex"
+    source = "orthographic"
+    granularity = ("word",)
+    default_model = "Reson8/Rumble-2-Flash"
+
+    def _extra_argv(self) -> list[str]:
+        """worker.py <jobs> <model> <device> <task>."""
+        return [str(self.params.get("device", "cuda")), "align"]
